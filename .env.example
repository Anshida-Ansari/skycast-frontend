# ==========================================
# SkyCast Frontend Environment Variables
# ==========================================

# Production API Base URL (Set in Vercel project environment variables)
# Point this to your live Render backend URL:
# Example: https://skycast-backend.onrender.com
# For local dev, leave as '/api/v1' to use the local Vite proxy
VITE_API_URL=https://skycast-backend.onrender.com
